#!/usr/bin/env python3
"""
run_scan_now.py — Manually trigger the nightly scanner from the command line.

Usage:
    python scripts/run_scan_now.py                              # quick: 50/universe, fast
    python scripts/run_scan_now.py --full                       # full: all universes, fast
    python scripts/run_scan_now.py --full --spread-minutes 360  # spread over 6 hours (nightly safe)
    python scripts/run_scan_now.py --universes sp500 nasdaq100 --max 50

Features:
    --spread-minutes N    Distribute ALL tickers evenly across N minutes (e.g. 360 = 12am–6am).
                          Sleep between each ticker submission. 0 = no spreading (default).
    --retry-proxy         After each universe completes, retry failed tickers via DataImpulse
                          rotating residential proxy. Credentials from DATAIMPULSE_USER/PASS env vars.

Universes: sp500, sp100, dow30, nasdaq100, russell1000, russell2000, russell3000

Full-universe ticker counts (approximate):
  sp500       ~505
  nasdaq100   ~101
  russell2000 ~1925
  TOTAL       ~2531  (fast: ~20 min  |  spread 6h: gentle on Yahoo)
"""

import sys
import os
import json
import argparse
import time
import logging
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
from pathlib import Path
from typing import Optional

# ── Path setup ────────────────────────────────────────────────────────────────
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'backend'))

from app.services.scanner import scan_ticker, assign_percentile_rank, assign_confidence
from app.services.index_universe_service import get_universe_tickers
from app.services.ai_summary_service import generate_scan_summary

# ── Logging ───────────────────────────────────────────────────────────────────
logging.basicConfig(
    force=True,
    level=logging.INFO,
    format='%(asctime)s  %(levelname)-8s %(message)s',
    datefmt='%H:%M:%S',
)
for _noisy in ('yfinance', 'peewee', 'urllib3', 'urllib3.connectionpool', 'requests'):
    logging.getLogger(_noisy).setLevel(logging.CRITICAL)
log = logging.getLogger('run_scan_now')

# ── Defaults ──────────────────────────────────────────────────────────────────
DEFAULT_UNIVERSES = ['sp500', 'nasdaq100', 'russell2000']
DEFAULT_MAX       = 50
FULL_MAX          = 9999
OUTPUT_FILE       = ROOT / 'scan_results_latest.json'
PARTIAL_FILE      = ROOT / 'scan_results_partial.json'   # written after each universe


# ─────────────────────────────────────────────────────────────────────────────
# Proxy session builder
# ─────────────────────────────────────────────────────────────────────────────
def _build_proxy_session() -> Optional[object]:
    """Build a requests.Session routed through DataImpulse rotating residential proxy.
    Returns None if credentials are not configured."""
    import requests
    user = os.environ.get('DATAIMPULSE_USER', '')
    pwd  = os.environ.get('DATAIMPULSE_PASS', '')
    host = os.environ.get('DATAIMPULSE_HOST', 'gw.dataimpulse.com')
    port = os.environ.get('DATAIMPULSE_PORT', '823')

    # Fall back to config.py settings if env vars not set
    if not user or not pwd:
        try:
            from app.core.config import settings as cfg
            user = cfg.dataimpulse_user
            pwd  = cfg.dataimpulse_pass
            host = cfg.dataimpulse_host
            port = str(cfg.dataimpulse_port)
        except Exception:
            pass

    if not user or not pwd:
        return None

    proxy_url = f'http://{user}:{pwd}@{host}:{port}'
    session = requests.Session()
    session.proxies = {'http': proxy_url, 'https': proxy_url}
    session.timeout = 25
    log.info(f'DataImpulse proxy session built → {host}:{port}')
    return session


# ─────────────────────────────────────────────────────────────────────────────
# Result sorter
# ─────────────────────────────────────────────────────────────────────────────
def _sort_results(results: list) -> list:
    return sorted(
        results,
        key=lambda r: (
            -(r.get('score') or 0),
            -(r.get('volume_ratio') or 0),
            -(r.get('volatility') or 0),
        )
    )


# ─────────────────────────────────────────────────────────────────────────────
# Core scan_universe — parallel with stall detection + failure tracking
# ─────────────────────────────────────────────────────────────────────────────
def scan_universe(
    universe_id: str,
    max_tickers: int,
    max_workers: int = 10,
    inter_ticker_sleep: float = 0.0,
    session=None,
) -> tuple[list, list]:
    """Scan one universe.

    Returns:
        (results, failed_tickers)
        results        — list of scan result dicts
        failed_tickers — list of tickers that returned None or timed out
    """
    log.info(f'[{universe_id}] Fetching tickers…')
    tickers = get_universe_tickers(universe_id)
    if not tickers:
        log.warning(f'[{universe_id}] No tickers returned — skipping.')
        return [], []

    tickers = tickers[:max_tickers]
    spread_label = f'  inter-ticker sleep: {inter_ticker_sleep:.1f}s' if inter_ticker_sleep > 0 else ''
    log.info(f'[{universe_id}] Scanning {len(tickers)} tickers  workers={max_workers}{spread_label}')

    results:  list = []
    failed:   list = []
    executor = ThreadPoolExecutor(max_workers=max_workers)

    try:
        futures: dict = {}
        # Submit tickers with optional sleep between submissions to spread load
        for ticker in tickers:
            f = executor.submit(scan_ticker, ticker, 120, False, session)
            futures[f] = ticker
            if inter_ticker_sleep > 0:
                time.sleep(inter_ticker_sleep)

        done_count = 0
        pending = set(futures.keys())
        while pending:
            finished, pending = wait(pending, timeout=60, return_when=FIRST_COMPLETED)
            if not finished:
                stuck = [futures[f] for f in pending]
                log.warning(
                    f'[{universe_id}] No progress for 60s — abandoning {len(stuck)} stuck tickers: '
                    f'{", ".join(stuck[:10])}{"…" if len(stuck) > 10 else ""}'
                )
                failed.extend(stuck)
                break
            for future in finished:
                done_count += 1
                ticker = futures[future]
                try:
                    r = future.result(timeout=1)
                    if r:
                        r['universe'] = universe_id
                        results.append(r)
                    else:
                        failed.append(ticker)
                except Exception as exc:
                    log.debug(f'[{universe_id}] {ticker} error: {exc}')
                    failed.append(ticker)
                if done_count % 25 == 0 or done_count == len(tickers):
                    log.info(
                        f'[{universe_id}]   {done_count}/{len(tickers)} scanned  '
                        f'{len(results)} hits  {len(failed)} failed'
                    )
    finally:
        executor.shutdown(wait=False, cancel_futures=True)

    log.info(f'[{universe_id}] Done — {len(results)} hits, {len(failed)} failed.')
    return results, failed


# ─────────────────────────────────────────────────────────────────────────────
# Proxy retry — sequential, one by one
# ─────────────────────────────────────────────────────────────────────────────
def retry_failed_tickers(
    failed: list,
    universe_id: str,
    proxy_session,
    existing_results: list,
) -> tuple[list, list]:
    """Retry a list of failed tickers sequentially through the proxy session.

    Returns:
        (new_results, still_failed)
    """
    if not failed:
        return [], []
    if proxy_session is None:
        log.warning(f'[{universe_id}] {len(failed)} failed tickers — no proxy configured, skipping retry.')
        return [], failed

    log.info(f'[{universe_id}] Retrying {len(failed)} failed tickers via proxy…')
    new_results:   list = []
    still_failed:  list = []

    for i, ticker in enumerate(failed, 1):
        try:
            r = scan_ticker(ticker, 120, False, proxy_session)
            if r:
                r['universe'] = universe_id
                r['via_proxy'] = True
                new_results.append(r)
                log.debug(f'[{universe_id}] ✓ proxy recovered {ticker}')
            else:
                still_failed.append(ticker)
        except Exception as exc:
            log.debug(f'[{universe_id}] proxy retry failed {ticker}: {exc}')
            still_failed.append(ticker)

        if i % 10 == 0 or i == len(failed):
            log.info(
                f'[{universe_id}] proxy retry {i}/{len(failed)}  '
                f'recovered: {len(new_results)}  still failed: {len(still_failed)}'
            )

    log.info(
        f'[{universe_id}] Proxy retry complete — '
        f'{len(new_results)} recovered, {len(still_failed)} unrecoverable.'
    )
    return new_results, still_failed


# ─────────────────────────────────────────────────────────────────────────────
# Write partial results file (so partial data is available before scan ends)
# ─────────────────────────────────────────────────────────────────────────────
def _write_partial(all_results: list, started_at: str, universes_done: list):
    try:
        payload = {
            'partial': True,
            'scan_started_at': started_at,
            'universes_completed': universes_done,
            'total_hits': len(all_results),
            'results': _sort_results(all_results)[:200],
        }
        PARTIAL_FILE.write_text(json.dumps(payload, indent=2, default=str))
    except Exception:
        pass


# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────
def main():
    parser = argparse.ArgumentParser(description='Run the stock AI scanner manually.')
    parser.add_argument('--universes', nargs='+', default=DEFAULT_UNIVERSES, metavar='UNIVERSE')
    parser.add_argument('--max',  type=int, default=None, metavar='N',
                        help=f'Max tickers per universe (default: {DEFAULT_MAX} quick, all if --full)')
    parser.add_argument('--full', action='store_true',
                        help='Scan every ticker in every universe (~2,531 total)')
    parser.add_argument('--workers', type=int, default=10, metavar='N',
                        help='Parallel workers per universe (default: 10)')
    parser.add_argument('--top', type=int, default=25, metavar='N',
                        help='Top N results for summary (default: 25)')
    parser.add_argument('--spread-minutes', type=int, default=0, metavar='MIN',
                        help='Spread ALL ticker submissions across this many minutes. '
                             '360 = one ticker every ~8.5s across 6 hours. 0 = no spreading (default).')
    parser.add_argument('--retry-proxy', action='store_true',
                        help='Retry failed tickers via DataImpulse rotating proxy after each universe. '
                             'Requires DATAIMPULSE_USER and DATAIMPULSE_PASS env vars (or config.py).')
    args = parser.parse_args()

    # ── Resolve scan parameters ───────────────────────────────────────────────
    if args.full:
        max_tickers = FULL_MAX
        mode = 'FULL (all tickers)'
    elif args.max is not None:
        max_tickers = args.max
        mode = f'capped at {args.max}/universe'
    else:
        max_tickers = DEFAULT_MAX
        mode = f'quick ({DEFAULT_MAX}/universe)'

    # ── Inter-ticker sleep for spreading ─────────────────────────────────────
    inter_ticker_sleep = 0.0
    if args.spread_minutes > 0:
        # Estimate total tickers to distribute sleep evenly
        # We'll recalculate per-universe after fetching actual ticker counts,
        # but provide a global budget here for logging.
        total_seconds = args.spread_minutes * 60
        # Approx: S&P500=503, Nasdaq=101, Russell=1925 → ~2529 total
        approx_total = 2529 if args.full else (len(args.universes) * (max_tickers if max_tickers < 9999 else 843))
        inter_ticker_sleep = total_seconds / max(approx_total, 1)
        log.info(
            f'Spread mode: {args.spread_minutes} min → ~{inter_ticker_sleep:.1f}s between each ticker submission'
        )

    # ── Proxy session ─────────────────────────────────────────────────────────
    proxy_session = None
    if args.retry_proxy:
        proxy_session = _build_proxy_session()
        if proxy_session is None:
            log.warning('--retry-proxy requested but no DataImpulse credentials found. '
                        'Set DATAIMPULSE_USER and DATAIMPULSE_PASS env vars.')

    # ── Header ────────────────────────────────────────────────────────────────
    started_at = datetime.utcnow().isoformat() + 'Z'
    log.info('═' * 60)
    log.info(f'Stock AI Scanner  [{mode}]')
    log.info(f'Started   : {started_at}')
    log.info(f'Universes : {", ".join(args.universes)}')
    log.info(f'Workers   : {args.workers}   Top: {args.top}')
    if inter_ticker_sleep > 0:
        eta_min = int(inter_ticker_sleep * approx_total / 60)
        log.info(f'Spread    : {args.spread_minutes} min window  (~{eta_min} min ETA)')
    if proxy_session:
        log.info('Proxy     : DataImpulse rotating residential — retrying failures')
    log.info('═' * 60)

    # ── Pre-warm yfinance session ─────────────────────────────────────────────
    log.info('Pre-warming Yahoo Finance session…')
    try:
        import yfinance as yf
        yf.download('SPY', period='2d', progress=False, auto_adjust=True)
        log.info('Session ready.')
    except Exception as e:
        log.warning(f'Pre-warm failed (will still try): {e}')

    # ── Scan each universe ────────────────────────────────────────────────────
    all_results:     list = []
    all_failed:      dict = {}   # {universe_id: [tickers]}
    universe_stats:  dict = {}
    universes_done:  list = []

    for uid in args.universes:
        t0 = time.time()
        results, failed = scan_universe(
            uid, max_tickers, args.workers, inter_ticker_sleep
        )
        elapsed = round(time.time() - t0, 1)

        # ── Proxy retry for this universe ─────────────────────────────────
        proxy_recovered = []
        if failed and proxy_session:
            proxy_recovered, still_failed = retry_failed_tickers(failed, uid, proxy_session, results)
            results.extend(proxy_recovered)
            all_failed[uid] = still_failed
        else:
            all_failed[uid] = failed

        sorted_res = _sort_results(results)
        universe_stats[uid] = {
            'scanned':         len(results),
            'hits':            len(sorted_res),
            'failed':          len(all_failed[uid]),
            'proxy_recovered': len(proxy_recovered),
            'elapsed_s':       elapsed,
        }
        all_results.extend(sorted_res)
        universes_done.append(uid)

        log.info(
            f'[{uid}] ✓  hits={len(sorted_res)}  '
            f'failed={len(all_failed[uid])}  '
            f'proxy_recovered={len(proxy_recovered)}  '
            f'time={elapsed}s'
        )

        # Write partial results so frontend can show data before full scan ends
        _write_partial(all_results, started_at, universes_done)

    # ── Final global proxy retry for ALL remaining failed tickers ─────────────
    if proxy_session:
        all_remaining_failed = [(uid, t) for uid, tickers in all_failed.items() for t in tickers]
        if all_remaining_failed:
            log.info(f'Global proxy retry: {len(all_remaining_failed)} tickers still failed across all universes…')
            for uid in args.universes:
                still = all_failed.get(uid, [])
                if still:
                    recovered, unrecoverable = retry_failed_tickers(still, uid, proxy_session, all_results)
                    if recovered:
                        all_results.extend(recovered)
                        universe_stats[uid]['proxy_recovered_final'] = len(recovered)
                    all_failed[uid] = unrecoverable

    # ── Percentile ranks across full result set ───────────────────────────────
    all_scores = [r.get('score') or 0 for r in all_results]
    for r in all_results:
        r['percentile_rank'], r['percentile_label'] = assign_percentile_rank(r.get('score') or 0, all_scores)

    global_top = _sort_results(all_results)[:args.top]

    # ── AI summary ────────────────────────────────────────────────────────────
    log.info(f'Generating AI summary for top {len(global_top)} stocks…')
    try:
        ai_summary = generate_scan_summary(global_top)
    except Exception as e:
        log.warning(f'AI summary failed: {e}')
        ai_summary = None

    finished_at = datetime.utcnow().isoformat() + 'Z'

    # ── Build final payload ───────────────────────────────────────────────────
    total_failed   = sum(len(v) for v in all_failed.values())
    total_recovered = sum(
        s.get('proxy_recovered', 0) + s.get('proxy_recovered_final', 0)
        for s in universe_stats.values()
    )

    payload = {
        'scan_started_at':   started_at,
        'scan_finished_at':  finished_at,
        'universes_scanned': args.universes,
        'max_per_universe':  args.max,
        'total_hits':        len(all_results),
        'total_failed':      total_failed,
        'total_proxy_recovered': total_recovered,
        'spread_minutes':    args.spread_minutes,
        'global_top':        global_top,
        'by_universe':       universe_stats,
        'failed_by_universe': {k: v for k, v in all_failed.items() if v},
        'ai_summary':        ai_summary,
    }

    OUTPUT_FILE.write_text(json.dumps(payload, indent=2, default=str))
    # Remove partial file now that the full file is written
    try:
        PARTIAL_FILE.unlink(missing_ok=True)
    except Exception:
        pass

    log.info(f'Results saved → {OUTPUT_FILE}')

    # ── Console summary ───────────────────────────────────────────────────────
    log.info('═' * 60)
    log.info(f'SCAN COMPLETE')
    log.info(f'  Total hits     : {len(all_results)}')
    log.info(f'  Total failed   : {total_failed}')
    log.info(f'  Proxy recovered: {total_recovered}')
    log.info(f'  Duration       : {started_at} → {finished_at}')
    log.info('─' * 60)
    log.info(f'TOP {len(global_top)} PICKS')
    for i, r in enumerate(global_top, 1):
        cats = ', '.join(r.get('categories') or []) or '—'
        log.info(
            f'  {i:>2}. {r.get("ticker","?"):<8} '
            f'score={r.get("score",0):>5.1f}  '
            f'RSI={str(r.get("rsi") or "?"):>5}  '
            f'vol={r.get("volume_ratio") or 0:>4.1f}x  '
            f'[{r.get("universe","?")}]  {cats}'
        )
    if total_failed > 0:
        log.info('─' * 60)
        log.info(f'UNRECOVERABLE FAILURES ({total_failed} total):')
        for uid, tickers in all_failed.items():
            if tickers:
                log.info(f'  [{uid}] {", ".join(tickers[:20])}{"…" if len(tickers) > 20 else ""}')
    if ai_summary:
        log.info('─' * 60)
        log.info('AI SUMMARY')
        for line in ai_summary.splitlines():
            log.info(f'  {line}')
    log.info('═' * 60)


if __name__ == '__main__':
    main()
