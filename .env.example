# Local development environment template
# Copy this file to .env and fill in only the keys you need.

# Database
DATABASE_URL=sqlite:///./backend/data/scanner.db

# Scheduler
SCHEDULER_ENABLED=false
DEFAULT_SCAN_TIME=02:00
DEFAULT_TIMEZONE=America/New_York
MAX_CONCURRENT_SCHEDULED_SCANS=1

# Remote scan ingest callback auth
SCAN_INGEST_TOKEN=change-me

# AI summaries
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=stock-ai-scanner
HUGGINGFACE_API_KEY=
HUGGINGFACE_ENDPOINT_URL=
HUGGINGFACE_MODEL_NAME=

# News
NEWS_LOOKBACK_DAYS=3

# Fundamentals
# Alpha Vantage is optional. Without it, earnings dates fall back to yfinance when available.
ALPHAVANTAGE_API_KEY=
FUNDAMENTALS_CACHE_TTL_HOURS=24

# Optional data files generated by separate ingestion jobs/providers
INSTITUTIONAL_OWNERSHIP_CHANGES_FILE=
GOVERNMENT_TRADES_FILE=
GOVERNMENT_TRADES_CACHE_TTL_HOURS=6

# Optional paid/third-party providers for future ingestion jobs
QUIVER_API_KEY=

# Optional proxy settings for Yahoo retry jobs
DATAIMPULSE_USER=
DATAIMPULSE_PASS=
DATAIMPULSE_HOST=gw.dataimpulse.com
DATAIMPULSE_PORT=823
