# Database
DATABASE_URL=mysql+pymysql://scanner:scannerpassword@localhost:3306/stock_scanner

# Firebase (client-side config stored in frontend)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Scheduler
SCHEDULER_ENABLED=true
DEFAULT_SCAN_TIME=02:00
DEFAULT_TIMEZONE=America/New_York
MAX_CONCURRENT_SCHEDULED_SCANS=1

# Other
SAMPLE_SETTING=example
